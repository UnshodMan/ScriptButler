{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScriptButler",
  "version": "0.1.0",
  "identifier": "com.scriptbutler.app",
  "build": {
    "beforeDevCommand": "npm run build:cli && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run build:cli",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ScriptButler",
        "width": 620,
        "height": 800,
        "minWidth": 520,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/sbctl"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi",
        "installerHooks": "nsis/sbctl-hooks.nsh",
        "languages": [
          "English",
          "SimpChinese",
          "TradChinese",
          "Japanese",
          "Korean",
          "Spanish",
          "French",
          "German",
          "Russian"
        ]
      }
    }
  }
}
